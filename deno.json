{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite@^8.2.2",
    "build": "deno run -A npm:vite@^8.2.2 build",
    "preview": "deno run -A npm:vite@^8.2.2 preview",
    "serve": "deno run --allow-net --allow-read=dist src/server.ts",
    "check": "deno check src/main.tsx src/server.ts",
    "test:unit": "deno test src/core/ src/hooks/",
    "test:components": "deno run -A npm:vitest@^4.1.8 run",
    "test:e2e": "deno run -A npm:@playwright/test@^1.62.1 test",
    "test": "deno task test:unit && deno task test:components",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test && deno task build && deno task test:e2e"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/random": "jsr:@std/random@^0.1.5",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "daisyui": "npm:daisyui@^5.5.23",
    "html-to-image": "npm:html-to-image@^1.11.13",
    "lucide-react": "npm:lucide-react@^1.18.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "@types/react": "npm:@types/react@^19.2.18",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.2.2",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
    "vitest": "npm:vitest@^4.1.8",
    "@testing-library/react": "npm:@testing-library/react@^16.3.3",
    "@testing-library/user-event": "npm:@testing-library/user-event@^14.6.7",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^7.0.1",
    "happy-dom": "npm:happy-dom@^20.13.2",
    "@playwright/test": "npm:@playwright/test@^1.62.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "lineWidth": 160,
    "exclude": [
      ".agents/",
      "dist/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "react"
      ]
    }
  },
  "deploy": {
    "org": "paularoid",
    "app": "team-scrambler-v2"
  }
}
